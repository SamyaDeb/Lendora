# Lendora compliance signer (compliance/). Secrets come from the host's secret manager; no values here.
LENDORA_NETWORK=
RPC_URL=
DATABASE_URL=
COMPLIANCE_SCHEMA=lendora_compliance
PORT=42071
HOST=0.0.0.0
# Attestation signer (RT-R2): a key (or a file with it) from the secret manager, or a remote KMS/HSM signer.
COMPLIANCE_SIGNER_KEY=
COMPLIANCE_SIGNER_KEY_FILE=
COMPLIANCE_REMOTE_SIGNER_URL=
COMPLIANCE_REMOTE_SIGNER_AUTH=
COMPLIANCE_SIGNER_ADDRESS=
# Sanctions screen (CP-R3): deny-list | chainalysis | trm (decision pending, Q5). Mainnet (4663) refuses deny-list,
# unknown names and a missing key (CP-R8). The deny list is checked before any provider. Failures fail closed.
SANCTIONS_PROVIDER=
SANCTIONS_API_KEY=
SANCTIONS_DENY_LIST=
# Optional: per-request timeout (ms, default 5000), TRM chain name (default ethereum, A37), https egress proxy URL.
SANCTIONS_TIMEOUT_MS=
SANCTIONS_TRM_CHAIN=
SANCTIONS_API_URL=
# CP-R1 overrides of packages/sdk/data/compliance.json (comma-separated ISO codes).
RESTRICTED_COUNTRIES=
RESTRICTED_REGIONS=
# CP-R2 datacenter/VPN ranges override (comma-separated CIDRs; default config/datacenter-ranges.json).
DATACENTER_RANGES=
# Geo and client-IP headers are trusted only from the web app's edge proxy carrying this secret (CP-R8). Required,
# >= 32 chars, on every network except 31337: the service refuses to start without it (and TRUST_PROXY=true without it).
TRUST_PROXY=
PROXY_SECRET=
ALLOWED_ORIGINS=
# Attestations per minute, per client IP and per wallet (default 20).
ATTEST_RPM=
TERMS_VERSION=
# Local anvil only: country assumed when no geo header is present.
DEV_DEFAULT_COUNTRY=
