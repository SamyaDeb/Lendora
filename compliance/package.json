{
  "name": "@lendora/compliance",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "exports": {
    "./app": "./src/app.ts",
    "./server": "./src/server.ts"
  },
  "scripts": {
    "pretypecheck": "pnpm --filter @lendora/sdk build",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "pretest": "pnpm --filter @lendora/sdk build",
    "test": "vitest run",
    "dev": "tsx watch src/index.ts",
    "start": "tsx src/index.ts"
  },
  "dependencies": {
    "@hono/node-server": "^2.1.1",
    "@lendora/keepers": "workspace:*",
    "@lendora/sdk": "workspace:*",
    "hono": "^4.13.9",
    "pg": "^8.16.2",
    "viem": "^2.56.9",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@lendora/devnet": "workspace:*",
    "@types/node": "^22.20.4",
    "@types/pg": "^8.15.0",
    "tsx": "^4.21.0",
    "typescript": "~5.9.3",
    "vitest": "^3.2.7"
  }
}
