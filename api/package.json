{
  "name": "@stockline/api",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "exports": {
    "./app": "./src/app.ts",
    "./harness": "./test/harness.ts",
    "./server": "./src/server.ts"
  },
  "scripts": {
    "pretypecheck": "pnpm --filter @stockline/sdk build",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "pretest": "pnpm --filter @stockline/sdk build",
    "test": "vitest run",
    "dev": "tsx watch src/index.ts",
    "start": "tsx src/index.ts",
    "openapi": "tsx scripts/export-openapi.ts",
    "loadtest": "tsx loadtest/run.ts"
  },
  "dependencies": {
    "@hono/node-server": "^2.1.1",
    "@hono/zod-openapi": "^1.6.3",
    "@stockline/sdk": "workspace:*",
    "hono": "^4.13.9",
    "ioredis": "^6.0.0",
    "pg": "^8.16.2",
    "viem": "^2.56.9",
    "ws": "^8.22.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@stockline/devnet": "workspace:*",
    "@stockline/indexer": "workspace:*",
    "@types/autocannon": "^7.12.7",
    "@types/node": "^22.20.4",
    "@types/pg": "^8.15.0",
    "@types/ws": "^8.18.1",
    "autocannon": "^8.0.0",
    "openapi-typescript": "^7.13.0",
    "tsx": "^4.21.0",
    "typescript": "~5.9.3",
    "vitest": "^3.2.7"
  }
}
