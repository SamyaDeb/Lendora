# Lendora public API (api/). Copy to .env or set in the host's secret manager. No values here.
# Deployment key in @lendora/sdk addresses.json: 31337 (anvil), fork-4663, 46630 (testnet). Never 4663 in Phase 2.
LENDORA_NETWORK=
# Postgres with the indexer's views (ponder start --views-schema) and the API's own schema for API keys.
DATABASE_URL=
INDEXER_SCHEMA=lendora
API_SCHEMA=lendora_api
# Redis for rate limits, SIWE nonces and WebSocket fan-out across instances. Unset = in-memory (single instance).
REDIS_URL=
# JSON-RPC for /status lag, oracle params and SIWE (ERC-1271) verification.
RPC_URL=
PORT=42070
HOST=0.0.0.0
# true behind the edge proxy (Railway): the client IP is the first X-Forwarded-For hop.
TRUST_PROXY=
# OFF-7: proxies in front of the API that append to X-Forwarded-For (Railway edge = 1); the client IP is that hop from the right.
TRUSTED_PROXY_HOPS=
# Domain that SIWE messages must name (e.g. api.lendora.xyz).
SIWE_DOMAIN=
# SI-R10 tiers (defaults 60 / 600 req/min, 1 / 10 WebSocket connections).
FREE_RPM=
KEYED_RPM=
FREE_WS=
KEYED_WS=
MAX_KEYS_PER_ADDRESS=
STREAM_POLL_MS=
# Minimum age (ms) of the USDG Earn live chain reads; 0 = per block (anvil). 3000 on 46630 (~4 blocks/s).
DN_LIVE_CACHE_MS=
