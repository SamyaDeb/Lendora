# Lendora web app (web/). Public values are inlined at build time; no secrets in NEXT_PUBLIC_*.
NEXT_PUBLIC_CHAIN_ID=
NEXT_PUBLIC_RPC_URL=
NEXT_PUBLIC_API_URL=
NEXT_PUBLIC_WALLETCONNECT_PROJECT_ID=
# Server side
API_URL_INTERNAL=
COMPLIANCE_URL=
ALERTS_URL=
# Shared with the compliance service: proves geo headers come from this edge (never public). >= 32 chars (CP-R8).
PROXY_SECRET=
# Which edge sets the visitor's country and IP: vercel (default) | cloudflare | none | static. Only that platform's
# headers are forwarded; anything the browser sends is dropped (CP-R8). `static` (local testnet stack, next dev only;
# refused in production and on Vercel/Railway) uses GEO_STATIC_COUNTRY (+ optional GEO_STATIC_REGION, GEO_STATIC_IP).
GEO_PLATFORM=
GEO_STATIC_COUNTRY=
# CP-R1 overrides (default packages/sdk/data/compliance.json)
RESTRICTED_COUNTRIES=
RESTRICTED_REGIONS=

# OFF-12: NEXT_PUBLIC_* values are inlined into the browser bundle. NEXT_PUBLIC_RPC_URL must be a public endpoint or a
# key restricted to the app's domain; never a private provider key. Its origin and NEXT_PUBLIC_API_URL's go into the CSP.
