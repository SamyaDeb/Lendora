NEXT_PUBLIC_CHAIN_ID=
NEXT_PUBLIC_RPC_URL=
NEXT_PUBLIC_API_URL=
NEXT_PUBLIC_WALLETCONNECT_PROJECT_ID=
# Server side
API_URL_INTERNAL=
COMPLIANCE_URL=
ALERTS_URL=
