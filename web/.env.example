# Stockline web app (web/). Public values are inlined at build time; no secrets in NEXT_PUBLIC_*.
NEXT_PUBLIC_CHAIN_ID=
NEXT_PUBLIC_RPC_URL=
NEXT_PUBLIC_API_URL=
NEXT_PUBLIC_WALLETCONNECT_PROJECT_ID=
# Server side
API_URL_INTERNAL=
COMPLIANCE_URL=
ALERTS_URL=
# Shared with the compliance service: proves geo headers come from this edge (never public). >= 32 chars (CP-R8).
PROXY_SECRET=
# Which edge sets the visitor's country and IP: vercel (default) | cloudflare | none. Only that platform's headers are
# forwarded; anything the browser sends is dropped (CP-R8).
GEO_PLATFORM=
# CP-R1 overrides (default packages/sdk/data/compliance.json)
RESTRICTED_COUNTRIES=
RESTRICTED_REGIONS=
