# Stockline keepers (allocator, guard, liquidator, alerts, feed-mirror, monitor, fee-converter). No values here.
SERVICE=
DEPLOYMENT_KEY=
RPC_URL=
# Dry run is the default; DRY_RUN=false needs KEEPER_SIGNER=env-key (KEEPER_PRIVATE_KEY from the secret manager) or
# KEEPER_SIGNER=remote (KMS/HSM bridge: KEEPER_REMOTE_SIGNER_URL, KEEPER_ADDRESS, optional KEEPER_REMOTE_SIGNER_AUTH).
DRY_RUN=true
KEEPER_SIGNER=
KEEPER_PRIVATE_KEY=
KEEPER_ADDRESS=
KEEPER_REMOTE_SIGNER_URL=
KEEPER_REMOTE_SIGNER_AUTH=
INTERVAL_MS=
HEALTH_PORT=8787
MAX_STALE_MS=
# alerts
DATABASE_URL=
INDEXER_SCHEMA=stockline
ALERTS_SCHEMA=stockline_alerts
PORT=42072
ALERTS_INTERVAL_MS=
RESEND_API_KEY=
ALERTS_EMAIL_FROM=
TELEGRAM_BOT_TOKEN=
ALERTS_WEBHOOK_SIGNING_KEY=
# feed-mirror (testnet): mainnet RPC, read-only
MAINNET_RPC_URL=
# monitor (MON-R1…R15): read-only, no signer. Pages go to every configured pager (console if none).
MONITOR_SCHEMA=stockline_monitor
MONITOR_INTERVAL_MS=2000
# keeper name=/health URL, comma-separated (MON-R9)
MONITOR_KEEPERS=
L2_GAP_SEC=300
# SI-R5 reconciliation inside the monitor (ms between runs; 0 disables)
RECONCILE_EVERY_MS=86400000
# keeper signer name=address whose ETH pays keeper gas, comma-separated (MON-R15), and the expected burn (wei/day)
MONITOR_GAS_WATCH=
GAS_BURN_WEI_PER_DAY=0
PAGERDUTY_ROUTING_KEY=
OPSGENIE_API_KEY=
MONITOR_TELEGRAM_BOT_TOKEN=
MONITOR_TELEGRAM_CHAT_ID=
MONITOR_WEBHOOK_URL=
MONITOR_WEBHOOK_SIGNING_KEY=
# local stack / drills: also append every page as a JSON line to this file
MONITOR_PAGE_FILE=
# fee-converter (FE-R4): weekly or above the threshold, in the NYSE regular session; 1% max slippage enforced onchain
FEE_CONVERTER_THRESHOLD_USDG=1000000000
FEE_CONVERTER_PERIOD_SEC=604800
FEE_CONVERTER_MIN_USDG=10000000
FEE_CONVERTER_SLIPPAGE_BPS=100
FEE_CONVERTER_REGULAR_HOURS_ONLY=true
FEE_CONVERTER_FROM_BLOCK=
