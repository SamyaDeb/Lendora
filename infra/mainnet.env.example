# Mainnet (4663) service environment, the launcher's template (scripts/mainnet-launch.sh, step 7 "services").
#
#   ## <service>         a Railway service (infra/railway/<service>.json); `shared` applies to every service
#   KEY=value            a literal
#   KEY=$NAME            a secret: taken from the launcher's environment variable NAME, set by name, never printed
#   KEY=<fill: …>        the owner fills it in a copy of this file (launch --services-env <copy>); refused while unfilled
#
# Order is the start order: the monitor first (MON-R16: it must see every governance action), keepers last. Services
# refuse 4663 until the launch has published addresses.json["4663"] (MN-R6).

## shared
LENDORA_NETWORK=4663
DEPLOYMENT_KEY=4663
RPC_URL=$MAINNET_SERVICE_RPC_URL

## monitor
SERVICE=monitor
DATABASE_URL=$MONITOR_DATABASE_URL
MONITOR_KEEPERS=<fill: name=url list of every keeper's /health>
PAGERDUTY_ROUTING_KEY=$PAGERDUTY_ROUTING_KEY
MONITOR_GAS_WATCH=<fill: keeper addresses to watch>

## indexer
SERVICE=indexer
DATABASE_URL=$INDEXER_DATABASE_URL
WS_URL=$MAINNET_SERVICE_WS_URL
PAGER_WEBHOOK_URL=$PAGER_WEBHOOK_URL

## reconcile
SERVICE=reconcile
DATABASE_URL=$INDEXER_DATABASE_URL
PAGER_WEBHOOK_URL=$PAGER_WEBHOOK_URL

## api
SERVICE=api
DATABASE_URL=$INDEXER_DATABASE_URL
REDIS_URL=$REDIS_URL
TRUST_PROXY=true
TRUSTED_PROXY_HOPS=1
SIWE_DOMAIN=<fill: app domain>

## compliance
SERVICE=compliance
DATABASE_URL=$COMPLIANCE_DATABASE_URL
COMPLIANCE_REMOTE_SIGNER_URL=<fill: KMS bridge URL>
COMPLIANCE_REMOTE_SIGNER_AUTH=$COMPLIANCE_REMOTE_SIGNER_AUTH
COMPLIANCE_SIGNER_ADDRESS=<fill: = LENDORA_ATTESTATION_SIGNER>
SANCTIONS_PROVIDER=<fill: chainalysis | trm>
SANCTIONS_API_KEY=$SANCTIONS_API_KEY
TRUST_PROXY=true
PROXY_SECRET=$PROXY_SECRET

## web
NEXT_PUBLIC_CHAIN_ID=4663
NEXT_PUBLIC_RPC_URL=<fill: public or domain-restricted RPC>
NEXT_PUBLIC_API_URL=<fill: public API URL>
NEXT_PUBLIC_WALLETCONNECT_PROJECT_ID=<fill>
COMPLIANCE_URL=http://compliance.railway.internal:42071
ALERTS_URL=http://alerts.railway.internal:42072
PROXY_SECRET=$PROXY_SECRET
GEO_PLATFORM=<fill: vercel | cloudflare>

## allocator
SERVICE=allocator
DRY_RUN=false
KEEPER_SIGNER=remote
KEEPER_REMOTE_SIGNER_URL=<fill>
KEEPER_REMOTE_SIGNER_AUTH=$ALLOCATOR_SIGNER_AUTH
KEEPER_ADDRESS=<fill: = LENDORA_ALLOCATOR>

## guard
SERVICE=guard
DRY_RUN=false
KEEPER_SIGNER=remote
KEEPER_REMOTE_SIGNER_URL=<fill>
KEEPER_REMOTE_SIGNER_AUTH=$GUARD_SIGNER_AUTH
KEEPER_ADDRESS=<fill: = LENDORA_GUARD_KEEPER>

## liquidator
SERVICE=liquidator
DRY_RUN=false
KEEPER_SIGNER=remote
KEEPER_REMOTE_SIGNER_URL=<fill>
KEEPER_REMOTE_SIGNER_AUTH=$LIQUIDATOR_SIGNER_AUTH
KEEPER_ADDRESS=<fill: liquidator bot key>
LIQUIDATOR_RECIPIENT=<fill: treasury-controlled address>

## fee-converter
SERVICE=fee-converter
DRY_RUN=false
KEEPER_SIGNER=remote
KEEPER_REMOTE_SIGNER_URL=<fill>
KEEPER_REMOTE_SIGNER_AUTH=$FEE_KEEPER_SIGNER_AUTH
KEEPER_ADDRESS=<fill: = LENDORA_FEE_KEEPER>

## alerts
SERVICE=alerts
DATABASE_URL=$INDEXER_DATABASE_URL
RESEND_API_KEY=$RESEND_API_KEY
ALERTS_EMAIL_FROM=<fill>
TELEGRAM_BOT_TOKEN=$TELEGRAM_BOT_TOKEN
ALERTS_WEBHOOK_SIGNING_KEY=$ALERTS_WEBHOOK_SIGNING_KEY

# Not started at launch: the feed mirror refuses 4663 (it writes mock feeds); the DN rebalancer and the NAV
# reporter/co-signer wait for a verified venue adapter (mainnet deploys the vault with no adapter and caps 0, MN-R7).
