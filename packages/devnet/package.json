{
  "name": "@lendora/devnet",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Local chain for Lendora: anvil with the DeployLocal state, and a chain driver that seeds realistic activity (Phase 2 task 0).",
  "exports": {
    ".": "./src/index.ts",
    "./fixtures/*": "./fixtures/*"
  },
  "scripts": {
    "pretypecheck": "pnpm --filter @lendora/sdk build",
    "typecheck": "tsc --noEmit",
    "pretest": "pnpm --filter @lendora/sdk build",
    "test": "vitest run",
    "drive": "tsx src/cli.ts",
    "state:dump": "tsx src/cli.ts dump-state",
    "drive:live": "tsx src/cli.ts live",
    "lint": "eslint ."
  },
  "dependencies": {
    "@lendora/sdk": "workspace:*",
    "pg": "^8.23.0",
    "viem": "^2.56.9"
  },
  "devDependencies": {
    "@types/node": "^22.20.4",
    "@types/pg": "^8.23.1",
    "tsx": "^4.21.0",
    "typescript": "~5.9.3",
    "vitest": "^3.2.7"
  }
}
